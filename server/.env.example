# Cubex server settings. Everything here is optional. Copy this file to
# server/.env (gitignored) and uncomment only what you want to change.

# Port the server listens on.
# PORT=3002

# Address the server listens on. Unset means every interface; 127.0.0.1 means
# only this computer can open Cubex.
# HOST=127.0.0.1

# Where Cubex keeps its data. The same directory also holds jobs.db and the
# secrets generated on first boot (.jwt-secret, .encryption-key), so back it
# up as a whole.
# DB_PATH=/var/lib/cubex/cubex.db

# Creates the account with this password on first boot, so an install that is
# public from the start can't be claimed by whoever opens it first. Without it,
# the first visitor chooses the password. Ignored once the account exists:
# change the password in Settings or with `npm run reset-password`.
# INITIAL_PASSWORD=

# The address webhook senders use, when it differs from the one you browse on
# (a tunnel, or a public domain in front of a LAN install). Without it, the
# webhook URL shown in the app uses whatever address your browser is on.
# PUBLIC_URL=https://cubex.example.com

# Per-sheet limits. Big jobs (import, sort, column changes, runs) work in small
# batches, so a million rows needs no special server; the CSV size caps disk use.
# MAX_ROWS_PER_SHEET=1000000
# MAX_COLUMNS_PER_SHEET=200
# MAX_CSV_UPLOAD_MB=500

# HTTP enrichment: most concurrent requests a single run may make.
# HTTP_MAX_CONCURRENCY=20

# How many AI / HTTP runs execute at the same time. Extra runs wait in line.
# SIDEQUEST_MAX_CONCURRENT_JOBS=4

# Failed sign-in attempts allowed per 15 minutes (for the whole instance).
# LOGIN_RATE_MAX=10

# MCP: also expose the transfer_rows and transform_column tools to agents.
# MCP_EFFICIENT_ROWS_ENABLED=1

# Secrets. Generated automatically on first boot and stored next to the
# database. Set them only if you want to manage them yourself
# (openssl rand -hex 32). Changing APP_ENCRYPTION_KEY later makes every saved
# API key unreadable.
# JWT_SECRET=
# APP_ENCRYPTION_KEY=
