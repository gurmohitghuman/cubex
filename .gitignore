# Dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
build/
*/dist/
*/build/

# Environment variables — never commit real secrets, only .example templates.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Catch anything else with .env in the name EXCEPT the .example templates.
# Belt-and-suspenders against accidentally committing a real prod env.
.env.*
!.env.example
!.env.*.example

# Database files + everything in the data directory: cubex.db, jobs.db, and the
# secrets generated on first boot (.jwt-secret, .encryption-key). Never commit
# these. server/data/e2e/ is the e2e harness's throwaway copy.
*.db
*.sqlite
*.sqlite3
server/data/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public
# Vite serves client/public/ → client/dist/ at build time; the SVG logo and
# any future static assets live here. The bare 'public' rule above (Gatsby
# template default) was excluding them from the repo, so production builds
# came up missing the logo. Un-ignore the directory.
!client/public/
!client/public/**

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code session state
.claude/

# Playwright output (the tests themselves are versioned)
test-results/
playwright-report/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Uploads
uploads/
*/uploads/

# Temp files
temp/
*/temp/
