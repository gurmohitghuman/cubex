 "endpoint": {
  "id": "treg.people.search",
  "name": "people.search — routed: best of 24 providers, own keys first",
  "summary": "Find people by a free-text description, or by company domain / title / country — provider-native rows in `people`",
  "provider": "treg",
  "provider_display": "treg",
  "kind": "routed",
  "method": "POST",
  "capability": "people.search",
  "capability_description": "Find people by role, company or location — lead lists and prospects (sales leads)",
  "platform": "people",
  "platform_label": "People & contact data",
