   }
  },
  "cost": {
   "type": "per_success",
   "unit": "call",
   "usd": 0.0,
   "varies": true,
   "note": "NOT free: misses are billed too. the children's range $0–$0.3 per hit, 0% markup; you pay the child that served AND every child tried before it that bills a miss (15 of 24 do), up to X-Treg-Route-Max-Cost (default $1 a call). X-Treg-Route-Exclude them, or X-Treg-Route-Waterfall: 0, to pay for one provider only",
   "per": 1
  },
  "observed": {
   "ok_rate": 0.852,
   "hit_rate": null,
   "samples": 703280,
   "hit_samples": 0
  },
  "input": {
   "bodyType": "json",
   "body": {
    "q": {
     "type": "str",
     "required": false,
     "note": "identity key (part of q)"
    },
    "company_domain": {
     "type": "str",
     "required": false,
     "note": "identity key (part of company_domain, company_domain+title)"
    },
    "title": {
     "type": "str",
     "required": false,
     "note": "identity key (part of company_domain+title, title)"
    },
    "full_name": {
     "type": "str",
     "required": false,
     "note": "identity key (part of full_name)"
    },
    "country": {
     "type": "str",
     "required": false,
     "note": "filter — default None; ISO country code, where the provider supports it"
    },
    "location": {
     "type": "str",
     "required": false,
     "note": "filter — default None; free-text place ('London, United Kingdom', 'Greater Phoenix') passed through to providers that take one; finer than country, never normalised"
    },
    "limit": {
     "type": "int",
     "required": false,
     "note": "filter — default 10; rows to return — THE price dial: most providers bill per row"
    },
    "keywords": {
     "type": "list",
     "required": false,
     "note": "filter — default None; skills, topics or domain terms the person must match ('microservices', 'match analysis') — the SUBSTANCE of most briefs; a provider with no keyword field answers a looser question and ranks below one that has it"
    }
   },
   "note": "Send everything you know about the subject — treg derives the rest (full_name ⇄ first+last), matches each provider on the variants it accepts ({q} | {company_domain} | {company_domain, title} | {title} | {full_name}) and sends each provider only the fields it wants. On a miss treg keeps trying providers, cheapest first, within X-Treg-Route-Max-Cost (default $1 per call; misses on per-success providers are free). Options ride as headers, never in the body: X-Treg-Route-Waterfall: 0 (stop at the first miss), X-Treg-Route-Max-Cost: <usd>, X-Treg-Route-Prefer / X-Treg-Route-Exclude: <provider>. The response is {output, raw, _treg: {served_by, tried}}; X-Treg-Served-By names the child."
  }
 },
