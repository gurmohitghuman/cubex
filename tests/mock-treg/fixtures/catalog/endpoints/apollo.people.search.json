  "name": "Search people by title, seniority, company or location",
  "summary": "Search Apollo's 200M+ contacts by title, seniority, company, location or tech (free)",
  "provider": "apollo",
  "provider_display": "Apollo.io",
  "kind": "data",
  "method": "POST",
  "capability": "people.search",
  "capability_description": "Find people by role, company or location — lead lists and prospects (sales leads)",
  "platform": "people",
  "platform_label": "People & contact data",
  "async": null,
  "status": null,
  "superseded_by": null,
  "platform_eligible": true,
  "platform_blocked": null,
  "overflow_price_usd": 0.0,
  "overflow_price_unit": "call",
  "overflow_via": "orthogonal",
  "test_request": {
   "bodyType": "json",
   "body": {
    "person_titles": [
     "head of marketing"
    ],
    "q_organization_domains_list": [
     "acme.example"
    ],
    "per_page": 3
   }
  },
  "cost": {
   "type": "free",
   "unit": "call",
   "usd": 0.0,
   "note": "documented free — 0 credits, because no contact data is returned. Counts against the plan's request limits only"
  },
  "observed": {
   "ok_rate": 1.0,
   "hit_rate": 0.5921,
   "samples": 601245,
   "hit_samples": 52513
  },
  "input": {
   "queryParams": {
    "person_titles[]": {
     "type": "array[string]",
     "required": false,
     "note": "job titles, matched loosely (OR across the list)",
     "example": [
      "head of marketing"
     ]
    },
    "person_seniorities[]": {
     "type": "array[string]",
     "required": false,
     "note": "owner, founder, c_suite, partner, vp, head, director, manager, senior, entry, intern"
    },
    "person_locations[]": {
     "type": "array[string]",
     "required": false,
     "note": "where the PERSON lives",
     "example": [
      "California, US"
     ]
    },
    "organization_locations[]": {
     "type": "array[string]",
     "required": false,
     "note": "where their COMPANY's HQ is"
    },
    "q_organization_domains_list[]": {
     "type": "array[string]",
     "required": false,
     "note": "restrict to employees of these company domains; max 1,000",
     "example": [
      "apollo.io"
     ]
    },
    "organization_num_employees_ranges[]": {
     "type": "array[string]",
     "required": false,
     "note": "employee-count bands as 'min,max' strings",
     "example": [
      "1,10"
     ]
    },
    "contact_email_status[]": {
     "type": "array[string]",
     "required": false,
     "note": "verified, unverified, likely to engage, unavailable"
    },
    "currently_using_any_of_technology_uids[]": {
     "type": "array[string]",
     "required": false,
     "note": "tech-stack filter, e.g. salesforce"
    },
    "revenue_range[min]": {
     "type": "integer",
     "required": false,
     "note": "annual revenue floor, integer with no symbols"
    },
    "revenue_range[max]": {
     "type": "integer",
     "required": false,
     "note": "annual revenue ceiling"
    },
    "page": {
     "type": "integer",
     "required": false,
     "note": "1-based; max 500 pages",
     "example": 1
    },
    "per_page": {
     "type": "integer",
     "required": false,
     "note": "max 100",
     "example": 1
    }
   },
   "note": "query-string params on a POST, with arrays in field[]=value form. RETURNS NO EMAILS OR PHONE NUMBERS AT ALL — that is why it is free. Pipe the person ids into apollo.people.enrich to get contact data, which is where the credits go. Result set is capped at 50,000 records"
  }
 },
