  "cost": {
   "type": "per_success",
   "unit": "call",
   "usd": 0.0,
   "varies": true,
   "note": "NOT free: misses are billed too. the children's range $0–$0.38 per hit, 0% markup; you pay the child that served AND every child tried before it that bills a miss (15 of 21 do), up to X-Treg-Route-Max-Cost (default $1 a call). X-Treg-Route-Exclude them, or X-Treg-Route-Waterfall: 0, to pay for one provider only",
   "per": 1
  },
  "observed": {
   "ok_rate": 0.915,
   "hit_rate": null,
   "samples": 42947,
   "hit_samples": 0
  },
  "input": {
   "bodyType": "json",
   "body": {
    "q": {
     "type": "str",
     "required": false,
     "note": "identity key (part of q)"
    },
    "name": {
     "type": "str",
     "required": false,
     "note": "identity key (part of name)"
    },
    "industry": {
     "type": "str",
     "required": false,
     "note": "identity key (part of industry)"
    },
    "technology": {
     "type": "str",
     "required": false,
     "note": "identity key (part of technology)"
    },
    "domain": {
     "type": "str",
     "required": false,
     "note": "identity key (part of domain)"
    },
    "country": {
     "type": "str",
     "required": false,
     "note": "filter — default None; ISO country code, where the provider supports it"
    },
    "limit": {
     "type": "int",
     "required": false,
     "note": "filter — default 10; rows to return — THE price dial: most providers bill per row"
    }
   },
   "note": "Send everything you know about the subject — treg derives the rest (full_name ⇄ first+last), matches each provider on the variants it accepts ({q} | {name} | {industry} | {technology} | {domain}) and sends each provider only the fields it wants. On a miss treg keeps trying providers, cheapest first, within X-Treg-Route-Max-Cost (default $1 per call; misses on per-success providers are free). Options ride as headers, never in the body: X-Treg-Route-Waterfall: 0 (stop at the first miss), X-Treg-Route-Max-Cost: <usd>, X-Treg-Route-Prefer / X-Treg-Route-Exclude: <provider>. The response is {output, raw, _treg: {served_by, tried}}; X-Treg-Served-By names the child."
  }
 },
