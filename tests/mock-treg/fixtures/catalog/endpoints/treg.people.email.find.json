  "cost": {
   "type": "per_success",
   "unit": "call",
   "usd": 0.004834,
   "varies": true,
   "note": "NOT free: misses are billed too. the children's range $0.004834–$0.15 per hit, 0% markup; you pay the child that served AND every child tried before it that bills a miss (1 of 23 do), up to X-Treg-Route-Max-Cost (default $1 a call). X-Treg-Route-Exclude them, or X-Treg-Route-Waterfall: 0, to pay for one provider only",
   "per": 1
  },
