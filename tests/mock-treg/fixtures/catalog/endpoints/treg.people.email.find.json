   "bodyType": "json",
   "body": {
    "domain": {
     "type": "str",
     "required": false,
     "note": "identity key (part of domain+full_name, domain+first_name+last_name)"
    },
    "full_name": {
     "type": "str",
     "required": false,
     "note": "identity key (part of domain+full_name)"
    },
    "first_name": {
     "type": "str",
     "required": false,
     "note": "identity key (part of domain+first_name+last_name)"
    },
    "last_name": {
     "type": "str",
     "required": false,
     "note": "identity key (part of domain+first_name+last_name)"
    },
    "linkedin_url": {
     "type": "url",
     "required": false,
     "note": "identity key (part of linkedin_url)"
    },
    "linkedin_handle": {
     "type": "str",
     "required": false,
     "note": "identity key (part of linkedin_handle)"
    }
   },
   "note": "Send everything you know about the subject — treg derives the rest (full_name ⇄ first+last), matches each provider on the variants it accepts ({domain, full_name} | {domain, first_name, last_name} | {linkedin_url} | {linkedin_handle}) and sends each provider only the fields it wants. On a miss treg keeps trying providers, cheapest first, within X-Treg-Route-Max-Cost (default $1 per call; misses on per-success providers are free). Options ride as headers, never in the body: X-Treg-Route-Waterfall: 0 (stop at the first miss), X-Treg-Route-Max-Cost: <usd>, X-Treg-Route-Prefer / X-Treg-Route-Exclude: <provider>. The response is {output, raw, _treg: {served_by, tried}}; X-Treg-Served-By names the child."
  }
 },
