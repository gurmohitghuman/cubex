     "type": "str",
     "required": true
    },
    "confidence": {
     "type": "float",
     "note": "0..1 — provider scales mapped; the original rides in raw"
    },
    "first_name": {
     "type": "str"
    },
    "last_name": {
     "type": "str"
    },
    "verified": {
     "type": "bool",
     "note": "the provider says it checked the mailbox"
    }
   },
   "miss": "email == null",
   "derive": {
    "full_name": "join(first_name, last_name)",
    "first_name": "split_first(full_name)",
    "last_name": "split_last(full_name)",
    "linkedin_url": "linkedin_url(linkedin_handle)",
    "linkedin_handle": "linkedin_handle(linkedin_url)"
   }
