# The MCP SDK pins zod@4, but openai@4.x still declares a `peerOptional zod@^3`.
# It's an OPTIONAL peer (the OpenAI SDK runs fine on zod 4 — it only uses zod for
# optional type helpers), so the conflict is benign. npm 11 (shipped with Node
# 24, which CI and the installers use) tolerates it; npm 10 (Node 22) fails
# `npm ci` on it with ERESOLVE.
# legacy-peer-deps makes the install behave identically across npm versions and
# environments. Remove if openai ever widens its zod peer to include v4.
legacy-peer-deps=true
