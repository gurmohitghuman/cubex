{
  "name": "cubex",
  "version": "1.0.0",
  "description": "Self-hosted AI spreadsheet: AI columns, HTTP API enrichment, webhooks, and an MCP server for agents.",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run prebuild:server && concurrently \"npm run dev:tsc\" \"npm run dev:server\" \"npm run dev:client\"",
    "prebuild:server": "tsc -p server/tsconfig.json && node scripts/server-dist.mjs",
    "dev:tsc": "tsc -p server/tsconfig.json --watch --preserveWatchOutput",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p server/tsconfig.json && node scripts/server-dist.mjs",
    "build:client": "tsc -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test:unit": "node scripts/unit-tests.mjs",
    "e2e": "node scripts/e2e-harness.mjs",
    "e2e:all": "node scripts/e2e-parallel.mjs",
    "db:reset": "node scripts/db-reset.cjs",
    "reset-password": "node server/dist/cli/reset-password.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@sidequest/sqlite-backend": "^1.15.0",
    "@types/jsonpath-plus": "^5.0.5",
    "ag-grid-community": "^34.2.0",
    "ag-grid-react": "^34.2.0",
    "argon2": "^0.44.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonpath-plus": "^10.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "lodash": "^4.18.1",
    "lucide-react": "^0.294.0",
    "multer": "^2.4.0",
    "openai": "^4.20.1",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.1",
    "sidequest": "^1.15.0",
    "tailwind-merge": "^2.1.0",
    "tailwindcss-animate": "^1.0.7",
    "tldts": "^7.4.18",
    "undici": "^7.15.0",
    "uuid": "^9.0.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
